{
    "download": {
        "interval": "1d",
        "period": "5y",
        "is_download": true,
        "data_type": "day"
    },
    "rsi_bollinger": {
        "rsi_period": 6,
        "bb_period": 200,
        "bb_multiplier": 2.0,
        "rsi_threshold": 50.0
    },
    "supertrend": {
        "atr_period": 10,
        "atr_multiplier": 3.0,
        "source": "hl2",
        "change_atr": true,
        "from_date": "2018-09-01",
        "to_date": "9999-01-01",
        "timezone": "Asia/Kolkata"
    },
    "fbb": {
        "length": 200,
        "multiplier": 3.0,
        "use_vwma": true,
        "intermediate": false
    },
    "seasonal": {
        "intermediate": false,
        "clean_output": false
    },
    "data": {
        "window_size": 20,
        "train_split_size": 0.80
    },
    "model": {
        "input_size": 1,
        "num_lstm_layers": 3,
        "lstm_size": 64,
        "dropout": 0.2
    },
    "training": {
        "device": "cpu",
        "batch_size": 64,
        "num_epoch": 100,
        "learning_rate": 0.01,
        "scheduler_step_size": 40
    }
}
